---
import RandomPost from '@/components/RandomPost.astro'
import Seal from '@/components/Seal.astro'
import { themeConfig } from '@/config'
import { hymmnosMottos } from '@/data/hymmnos'
import { getLangFromPath } from '@/i18n/lang'
import { getLocalizedPath } from '@/i18n/path'
import { getPosts } from '@/utils/content'

const { author } = themeConfig.site
const { links, startYear } = themeConfig.footer

const currentYear = new Date().getFullYear()
const year = Number(startYear) === currentYear
  ? startYear
  : `${startYear}-${currentYear}`

const currentLang = getLangFromPath(Astro.url.pathname)
const posts = await getPosts(currentLang)
const latestDate = posts.reduce((latest, post) => {
  const date = post.data.updated ?? post.data.published
  return date > latest ? date : latest
}, posts[0]?.data.updated ?? posts[0]?.data.published)
const lastUpdated = latestDate
  ? `最后更新于 ${latestDate.getFullYear()} 年 ${latestDate.getMonth() + 1} 月 ${latestDate.getDate()} 日`
  : ''
const socialLinks = links.map(({ name, url }) => {
  const isRSS = url === '/atom.xml' || url === '/rss.xml'
  const isEmail = /^[\w.-]+@[\w.-]+\.[a-z]{2,}$/i.test(url)

  if (isRSS) {
    const localizedPath = getLocalizedPath(url, currentLang)
    const href = import.meta.env.DEV
      ? localizedPath
      : localizedPath.slice(0, -1)

    return {
      name,
      href,
      target: '_blank',
      rel: 'noopener noreferrer',
    }
  }

  if (isEmail) {
    const href = `mailto:${url}`
    return {
      name,
      href,
      'data-umami-event': 'outbound-link-click',
      'data-umami-event-url': href,
    }
  }

  return {
    name,
    'href': url,
    'target': '_blank',
    'rel': 'noopener noreferrer',
    'data-umami-event': 'outbound-link-click',
    'data-umami-event-url': url,
  }
})
---
<footer class="site-footer">
  <div class="footer-content">
    <nav class="footer-links" aria-label="页脚链接">
      {socialLinks.map((link, index) => (
        <>
          <a {...link}>{link.name}</a>
          {index < socialLinks.length - 1 && <span aria-hidden="true"> / </span>}
        </>
      ))}
      <span aria-hidden="true"> / </span>
      <RandomPost />
    </nav>
    <p class="footer-credit">© {year} {author} · Powered by Astro</p>
    {lastUpdated && <p class="footer-note">{lastUpdated}</p>}
    <p
      class="footer-motto"
      data-mottos={JSON.stringify(hymmnosMottos)}
      aria-label="我很高兴能将自己化为诗歌"
    >
      <span class="motto-text">Was yea ra chs hymmnos mea</span>
      <span class="secret-motto" aria-hidden="true"> cEzE dand.</span>
    </p>
  </div>
  <Seal size={52} rotate={-2} />
</footer>

<!-- Hymmnos motto rotation: pick the day's sentence by client date + season.
     data-astro-rerun re-executes after ClientRouter soft navigations. -->
<script is:inline data-astro-rerun>
(function () {
  const motto = document.querySelector('.footer-motto')
  if (!motto?.dataset.mottos)
    return

  let pool
  try {
    pool = JSON.parse(motto.dataset.mottos)
  }
  catch {
    return
  }
  if (!Array.isArray(pool) || pool.length === 0)
    return

  // Seasonal pool: months 3-5 spring, 6-8 summer, 9-11 autumn, 12-2 winter.
  const month = new Date().getMonth() + 1
  const season = month <= 2 || month === 12
    ? 'winter'
    : month <= 5 ? 'spring' : month <= 8 ? 'summer' : 'autumn'
  const candidates = pool.filter(m => !m.season || m.season === season)
  if (candidates.length === 0)
    return

  const now = new Date()
  const dayOfYear = Math.floor((now - new Date(now.getFullYear(), 0, 0)) / 86400000)
  const picked = candidates[dayOfYear % candidates.length]

  const text = motto.querySelector('.motto-text')
  if (text)
    text.textContent = picked.hm
  motto.setAttribute('aria-label', picked.zh)
})()
</script>

<style>
  .site-footer {
    align-items: flex-end;
    gap: 24px;
    padding: 44px 0 60px;
  }

  .footer-content {
    min-width: 0;
  }

  .footer-links {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--secondary);
  }

  .footer-links a,
  .footer-links :global(.random-post) {
    color: var(--secondary);
    opacity: 1;
    text-decoration: none;
    transition: color 200ms ease-out;
  }

  .footer-links a:hover,
  .footer-links :global(.random-post):hover {
    color: var(--seal);
    opacity: 1;
    text-decoration: none;
  }

  .footer-credit,
  .footer-note {
    margin: 14px 0 0;
    color: var(--secondary);
  }

  .footer-credit {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .footer-note {
    font-size: 13.5px;
  }

  /* Hymmnos motto: Ar tonelico conlang line — a poem left untranslated. */
  .footer-motto {
    margin: 14px 0 0;
    font-family: "Hymmnos", var(--serif);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--secondary);
  }

  /* Konami-unlocked palette shows its own verse: "become the door". */
  .secret-motto {
    display: none;
    color: var(--seal);
  }

  :global(:root[data-palette='violet']) .secret-motto {
    display: inline;
  }
</style>
