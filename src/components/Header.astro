---
import type { Language } from '@/i18n/config'
import Button from '@/components/Button.astro'
import { getPageInfo } from '@/utils/page'

interface Props {
  supportedLangs?: Language[]
}

const { supportedLangs = [] } = Astro.props
const { isHome, isPost, getLocalizedPath } = getPageInfo(Astro.url.pathname)
const currentPath = Astro.url.pathname

const navItems = [
  { href: '/', label: '首页' },
  { href: '/archive/', label: '归档' },
  { href: '/projects/', label: '项目' },
  { href: '/friends/', label: '友链' },
  { href: '/now/', label: '此刻' },
  { href: '/about/', label: '关于' },
  { href: '/search/', label: '搜索' },
]

// 当前页判定：首页只高亮「首页」，文章页归入「归档」，其余按路径前缀匹配
function isActive(href: string) {
  if (href === '/') {
    return isHome
  }
  if (href === '/archive/' && isPost) {
    return true
  }
  return currentPath.includes(href)
}
---

<header class="top">
  <div class="wrap">
    <a class="brand" href={getLocalizedPath('/')}>
      <svg width="26" height="26" viewBox="-13 -13 26 26" aria-hidden="true">
        <circle r="12" fill="none" stroke="currentColor" />
        <circle r="8" fill="none" stroke="currentColor" stroke-width=".8" />
        <circle r="4" fill="none" stroke="currentColor" stroke-width=".6" />
        <circle r="1.6" fill="currentColor" />
        <path d="M0-12V-15M0 12V15M-12 0H-15M12 0H15" stroke="currentColor" />
      </svg>
      <span>Liushenwuzhu-Alpaca</span>
    </a>
    <nav class="nav" aria-label="站点导航">
      {navItems.map(item => (
        <a
          href={getLocalizedPath(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="tools">
      <Button supportedLangs={supportedLangs} />
    </div>
  </div>
</header>

<style>
  /* 单行页头：吸顶 + 半透明毛玻璃 */
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--hairline);
  }

  .top .wrap {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 62px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--latin);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .brand svg {
    flex: none;
    color: var(--line);
  }

  .nav {
    display: flex;
    gap: 22px;
    min-width: 0;
    margin-left: auto;
    /* 上下留白给当前项小圆环，避免被 overflow 裁掉 */
    padding: 4px 0;
    color: var(--ink-soft);
    font-size: 15px;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav a {
    position: relative;
    padding: 4px 0;
    line-height: 1.6;
    transition: color 300ms ease-out;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--ink);
  }

  /* 当前项：标签下方的小圆环 */
  .nav a[aria-current='page']::after {
    position: absolute;
    left: 50%;
    bottom: -3px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    content: '';
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .tools {
    display: flex;
    flex: none;
    gap: 10px;
    align-items: center;
  }

  @media (max-width: 760px) {
    .top .wrap {
      gap: 14px;
      /* 总高 56px：含 1px 底边 */
      height: 55px;
    }

    .brand span {
      display: none;
    }

    .nav {
      gap: 16px;
      font-size: 14px;
    }

    .tools {
      gap: 8px;
    }
  }
</style>
