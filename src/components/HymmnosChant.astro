---
interface Props {
  /** Hymmnos sentence, ASCII only (font covers the full latin glyph set). */
  hm: string
  /** Chinese translation — rendered into aria-label only, never displayed. */
  zh: string
  /** 'label'（默认）位于页面标题下方；'epigraph' 作为独立题记行。 */
  variant?: 'label' | 'epigraph'
}

const { hm, zh, variant = 'label' } = Astro.props
---

<!-- Untranslated Hymmnos chant; the translation lives in aria-label only
     (easter-egg philosophy: discovery threshold). -->
<p class:list={['page-chant', { 'page-chant--epigraph': variant === 'epigraph' }]} aria-label={zh}>{hm}</p>

<style>
  .page-chant {
    /* 位于 PageHead 标题下方 */
    margin: 6px 0 0;
    font-family: "Hymmnos", var(--serif);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--glyph);
  }

  .page-chant--epigraph {
    margin: 8px 0 0;
    font-size: 15px;
    letter-spacing: 0.08em;
  }
</style>
