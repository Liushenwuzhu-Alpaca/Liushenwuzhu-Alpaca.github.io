---
// 文章页右下角的回到顶部按钮；外圈进度环由 ReadingProgress 的滚动计算驱动
---

<button id="back-to-top" class="back-to-top" type="button" aria-label="回到顶部" data-pagefind-ignore>
  <svg class="btt-ring" viewBox="0 0 40 40" aria-hidden="true">
    <circle class="btt-track" cx="20" cy="20" r="19.25" />
    <circle class="btt-progress" cx="20" cy="20" r="19.25" pathLength="1" />
  </svg>
  <svg class="btt-arrow" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M8 13V3.5M3.75 7.5 8 3.25l4.25 4.25" />
  </svg>
</button>

<script>
function handleBackToTopClick(e: MouseEvent) {
  if (!(e.target instanceof Element) || !e.target.closest('#back-to-top'))
    return

  const reduce = document.documentElement.classList.contains('reduce-motion')
    || window.matchMedia('(prefers-reduced-motion: reduce)').matches
  // 文章页 html 带 scroll-smooth，减少动态时必须显式 instant 才会直接跳
  window.scrollTo({ top: 0, behavior: reduce ? 'instant' : 'smooth' })
}

document.addEventListener('click', handleBackToTopClick)
</script>

<style is:global>
  .back-to-top {
    position: fixed;
    right: calc(24px + env(safe-area-inset-right, 0px));
    bottom: calc(28px + env(safe-area-inset-bottom, 0px));
    z-index: 4;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--paper-card);
    color: var(--accent);
    box-shadow: var(--shadow-1);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.25s ease-out, transform 0.25s ease-out, visibility 0s linear 0.25s, color 0.2s ease-out;
  }
  .back-to-top.is-shown {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.25s ease-out, transform 0.25s ease-out, visibility 0s, color 0.2s ease-out;
  }
  .back-to-top:hover {
    color: var(--ink);
  }
  .back-to-top:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  /* 进度环：底圈即按钮的细边，铜线从 12 点方向顺时针画满 */
  .btt-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    pointer-events: none;
  }
  .btt-ring circle {
    fill: none;
    stroke-width: 1.5;
  }
  .btt-track {
    stroke: var(--hairline);
  }
  .btt-progress {
    stroke: var(--line);
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
  }

  .btt-arrow {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 移动端贴边更近，避开底部手势条 */
  @media (max-width: 760px) {
    .back-to-top {
      right: calc(12px + env(safe-area-inset-right, 0px));
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }
  }

  html.reduce-motion .back-to-top {
    transition: none;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
      transform: none;
    }
  }
</style>
