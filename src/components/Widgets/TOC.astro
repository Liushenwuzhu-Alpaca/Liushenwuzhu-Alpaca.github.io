---
import type { MarkdownHeading } from 'astro'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  headings: MarkdownHeading[]
}

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const { headings = [] } = Astro.props
const filteredHeadings = headings.filter(heading => heading.depth >= 2 && heading.depth <= 4)
---

{filteredHeadings.length > 1 && (
  <div
    id="toc-container"
    class="toc"
  >
    <input
      type="checkbox"
      id="toc-toggle"
      hidden
    />
    <div class="toc-head">
      <label
        for="toc-toggle"
        class="toc-label"
      >
        <span id="toc-mobile-text" class="kicker">
          {currentUI.toc}
        </span>
      </label>
    </div>

    <div id="toc-accordion-wrapper">
      <nav
        id="toc-accordion-content"
        class="toc"
        aria-label="Table of Contents"
      >
        <ul id="toc-links-list">
          {filteredHeadings.map(heading => (
            <li
              class={`toc-depth-${heading.depth}`}
            >
              <a
                href={`#${heading.slug}`}
                data-heading-id={heading.slug}
                class:list={[
                  { 'no-heti toc-links-h2': heading.depth === 2 },
                  { 'no-heti toc-links-h3': heading.depth === 3 },
                  { 'no-heti toc-links-h4': heading.depth === 4 },
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
)}

<script>
let observer: IntersectionObserver | null = null
let ticking = false
let lastLink: Element | null = null

const isDesktop = window.matchMedia('(min-width: 1101px)')

function getHeadingElements(tocList: HTMLElement) {
  return [...tocList.querySelectorAll<HTMLAnchorElement>('a[data-heading-id]')]
    .map((link) => {
      const id = link.dataset.headingId
      if (!id) {
        return null
      }
      const heading = document.getElementById(id)
      return heading ? { link, heading } : null
    })
    .filter((entry): entry is { link: HTMLAnchorElement, heading: HTMLElement } => entry !== null)
}

function setCurrentLink(nextLink: Element | null) {
  const tocList = document.getElementById('toc-links-list')
  if (!tocList) {
    return
  }

  tocList.querySelectorAll('a.is-current').forEach((link) => {
    link.classList.remove('is-current')
  })

  if (nextLink) {
    nextLink.classList.add('is-current')
  }
}

function scrollCurrentIntoView(activeLink: Element | null) {
  if (!activeLink || activeLink === lastLink || !isDesktop.matches) {
    return
  }

  activeLink.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  lastLink = activeLink
}

function handleScrollIntoView() {
  if (!ticking && isDesktop.matches) {
    window.requestAnimationFrame(() => {
      const activeLink = document.querySelector('#toc-links-list a.is-current')
      scrollCurrentIntoView(activeLink)
      ticking = false
    })
    ticking = true
  }
}

function setupObserver() {
  cleanupObserver()

  const tocList = document.getElementById('toc-links-list')
  if (!tocList) {
    return
  }

  const pairs = getHeadingElements(tocList)
  if (pairs.length === 0) {
    return
  }

  const visible = new Map<Element, IntersectionObserverEntry>()

  observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        visible.set(entry.target, entry)
      }
      else {
        visible.delete(entry.target)
      }
    }

    let current: Element | null = null
    let bestRatio = -1
    let bestTop = Number.POSITIVE_INFINITY

    for (const { link, heading } of pairs) {
      const entry = visible.get(heading)
      if (!entry) {
        continue
      }

      const top = entry.boundingClientRect.top
      const ratio = entry.intersectionRatio
      if (ratio > bestRatio || (ratio === bestRatio && top < bestTop)) {
        bestRatio = ratio
        bestTop = top
        current = link
      }
    }

    // Fallback: nearest heading above the fold when none are intersecting.
    if (!current) {
      let nearestTop = Number.NEGATIVE_INFINITY
      for (const { link, heading } of pairs) {
        const top = heading.getBoundingClientRect().top
        if (top <= 120 && top > nearestTop) {
          nearestTop = top
          current = link
        }
      }
      if (!current) {
        current = pairs[0]?.link ?? null
      }
    }

    setCurrentLink(current)
    handleScrollIntoView()
  }, {
    rootMargin: '-10% 0px -70% 0px',
    threshold: [0, 0.1, 0.25, 0.5, 1],
  })

  for (const { heading } of pairs) {
    observer.observe(heading)
  }

  // Seed initial current item.
  setCurrentLink(pairs[0]?.link ?? null)
  document.addEventListener('scroll', handleScrollIntoView, { passive: true })
}

function cleanupObserver() {
  if (observer) {
    observer.disconnect()
    observer = null
  }
  document.removeEventListener('scroll', handleScrollIntoView)
  setCurrentLink(null)
  lastLink = null
  ticking = false
}

document.addEventListener('astro:page-load', setupObserver)
document.addEventListener('astro:before-swap', cleanupObserver)
</script>

<style>
  /* 窄屏（≤1100px）：正文上方的折叠手风琴，点击标签展开 */
  #toc-container {
    margin-bottom: 1.5rem;
    padding-left: 1rem;
    border-left: 2px solid color-mix(in oklab, var(--secondary) 15%, transparent);
  }

  .toc-head {
    position: relative;
    width: 100%;
    height: 3rem;
  }

  .toc-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  /* 窄屏下三、四级标题缩进 */
  .toc-depth-3 {
    margin-left: 1rem;
  }

  .toc-depth-4 {
    margin-left: 2rem;
  }

  /* 宽屏（>1100px）：右栏常驻目录，空心圆点轨道，当前项圆点填实 */
  @media (min-width: 1101px) {
    #toc-container {
      margin-bottom: 0;
      padding-left: 0;
      border: 0;
    }

    .toc-head {
      height: auto;
    }

    /* 常驻展开，标签只作标题，不再可点 */
    .toc-label {
      position: static;
      display: block;
      cursor: default;
      pointer-events: none;
    }

    /* 标签只显示 kicker 样式的「目录」 */
    #toc-mobile-text {
      display: block;
      margin: 0 0 12px;
      font-weight: 400;
    }

    #toc-accordion-wrapper,
    #toc-toggle:checked ~ #toc-accordion-wrapper {
      grid-template-rows: 1fr;
    }

    #toc-accordion-content,
    #toc-toggle:checked ~ #toc-accordion-wrapper #toc-accordion-content {
      max-height: calc(100vh - 96px - 80px);
      padding: 0 0 0 5px;
      overflow-y: auto;
      scrollbar-width: none;
    }

    #toc-links-list {
      margin: 0;
      padding: 0 0 0 14px;
      border-left: 1px solid var(--hairline);
    }

    #toc-links-list > li {
      position: relative;
      margin: 0;
      padding: 5px 0;
      line-height: 1.55;
      color: var(--ink-soft);
    }

    /* 轨道上的空心圆点 */
    #toc-links-list > li::before {
      content: "";
      position: absolute;
      left: -18.5px;
      top: 13px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      border: 1px solid var(--line);
      background: var(--paper);
      transition: background-color 0.3s ease-out;
    }

    /* 三、四级标题：缩进，圆点缩小 */
    #toc-links-list > li.toc-depth-3,
    #toc-links-list > li.toc-depth-4 {
      font-size: 13px;
    }

    #toc-links-list > li.toc-depth-3 {
      padding-left: 12px;
    }

    #toc-links-list > li.toc-depth-4 {
      padding-left: 24px;
    }

    #toc-links-list > li:is(.toc-depth-3, .toc-depth-4)::before {
      left: -17.5px;
      top: 14px;
      width: 4px;
      height: 4px;
    }

    #toc-links-list > li:has(> a.is-current)::before {
      background: var(--line);
    }

    #toc-links-list a {
      font-size: inherit;
      font-weight: 400;
      color: inherit;
      text-decoration: none;
      transition: color 0.3s ease-out;
    }

    #toc-links-list a:hover {
      color: var(--accent);
    }

    #toc-links-list a.is-current {
      margin-left: 0;
      padding-left: 0;
      border-left: 0;
      font-weight: 400;
      color: var(--ink);
    }
  }
</style>
