---
import Astrolabe from '@/components/Astrolabe.astro'
import ChantIcon from '@/components/ChantIcon.astro'
import Seal from '@/components/Seal.astro'
import { allLocales } from '@/config'
import { friends } from '@/data/friends'
import { projects as fallbackProjects } from '@/data/projects'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getLocalizedPath, getPostPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { getPinnedPosts, getPosts } from '@/utils/content'
import { getPostDescription } from '@/utils/description'
import { getPinnedRepos } from '@/utils/github'
import { getSolarTerm } from '@/utils/solarterm'
import { getWritingStats } from '@/utils/stats'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const [pinnedPosts, allPosts, writingStats] = await Promise.all([
  getPinnedPosts(currentLang),
  getPosts(currentLang),
  getWritingStats(),
])
const featuredPosts = pinnedPosts.slice(0, 4)
// 最近列表包含置顶文章
const recentPostRows = allPosts.slice(0, 5)
const featuredIds = new Set(featuredPosts.map(post => post.id))
// Sync with the GitHub profile's pinned repos at build time; fall back to
// the hand-maintained list in src/data/projects.ts when the fetch fails.
const pinnedRepos = await getPinnedRepos('Liushenwuzhu-Alpaca')
const homeProjects = (pinnedRepos
  ? pinnedRepos.map(repo => ({
      name: repo.name,
      url: repo.url,
      desc: repo.description || repo.language || undefined,
      tags: repo.language && repo.description ? [repo.language] : [],
      stars: repo.stars,
    }))
  : fallbackProjects.map(p => ({ ...p, stars: 0 }))).slice(0, 4)
const homeFriends = friends.slice(0, 3)
const today = new Date()
const solarTerm = getSolarTerm(today)
const season = ['冬', '冬', '春', '春', '春', '夏', '夏', '夏', '秋', '秋', '秋', '冬'][today.getMonth()]
const heroMeta = `${solarTerm ?? season} · 建站第 ${writingStats.daysSinceLaunch} 日`
const formatDate = (date: Date) => date.toISOString().split('T')[0]
type HomePost = typeof recentPostRows[number]
const postSlug = (post: HomePost) => post.data.abbrlink || post.id.replace(/\.(md|mdx)$/, '')
function postTransitionName(post: HomePost) {
  return `post-${postSlug(post)}${currentLang ? `-${currentLang}` : ''}`
}
// 图标与文章页头 150px 图标同名，点进文章时小图标放大到页头位置
function iconTransitionName(post: HomePost) {
  return `icon-${postSlug(post)}${currentLang ? `-${currentLang}` : ''}`
}
---

<Layout>
  <section class="hero" aria-labelledby="home-title">
    <div>
      <span class="kicker">{heroMeta}</span>
      <h1 id="home-title">写技术学习，<br />也写<em>缓慢的思考</em>。</h1>
      <p class="intro">你好，我是 Liushenwuzhu-Alpaca，一名网络空间安全专业学生。在这里整理技术学习笔记，也保留学业与生活中的片段。</p>
      <div class="who">
        <div class="ava"><img src="/avatar.jpg" alt="头像：一只羊驼" width="52" height="52" /></div>
        <div class="meta"><b>Liushenwuzhu-Alpaca</b>USTC · 网络空间安全</div>
        <Seal char="向" size={40} rotate={-4} />
      </div>
    </div>
    <figure class="dial"><Astrolabe /></figure>
  </section>

  {featuredPosts.length > 0 && (
    <section class="blk" aria-labelledby="featured-title">
      <div class="rule"><span class="n">I</span><h2 id="featured-title">精选</h2></div>
      <div class="feat">
        {featuredPosts.map((post) => {
          const slug = postSlug(post)
          const description = getPostDescription(post, 'list')
          const tag = post.data.tags[0]
          return (
            <a class="card" href={getPostPath(slug, currentLang)} transition:name={postTransitionName(post)} data-disable-theme-toggle-transition>
              <ChantIcon name={post.data.hymmnos ?? slug} size={46} transitionName={iconTransitionName(post)} />
              <div>
                {post.data.hymmnos && <span class="chant" aria-hidden="true">{post.data.hymmnos}</span>}
                <h3>{post.data.title}</h3>
                {description && <p>{description}</p>}
                <div class="m">
                  <time datetime={formatDate(post.data.published)}>{formatDate(post.data.published)}</time>
                  <span>{post.remarkPluginFrontmatter.minutes} 分钟</span>
                  {tag && <span>{tag}</span>}
                </div>
              </div>
            </a>
          )
        })}
      </div>
    </section>
  )}

  {recentPostRows.length > 0 && (
    <section class="blk" aria-labelledby="recent-title">
      <div class="rule"><span class="n">II</span><h2 id="recent-title">最近</h2></div>
      <ul class="list">
        {recentPostRows.map((post) => {
          const slug = postSlug(post)
          return (
            <li>
              {/* 已在精选中出现的文章不再挂同名 transition（行与图标都不挂），避免 view-transition-name 重复 */}
              <a href={getPostPath(slug, currentLang)} transition:name={featuredIds.has(post.id) ? undefined : postTransitionName(post)} data-disable-theme-toggle-transition>
                <time datetime={formatDate(post.data.published)}>{formatDate(post.data.published)}</time>
                <ChantIcon name={post.data.hymmnos ?? slug} size={30} transitionName={featuredIds.has(post.id) ? undefined : iconTransitionName(post)} />
                <div>
                  <h3>{post.data.title}</h3>
                  {post.data.hymmnos && <span class="chant" aria-hidden="true">{post.data.hymmnos}</span>}
                </div>
                <span class="tags">{post.data.tags.slice(0, 3).join(' · ')}</span>
              </a>
            </li>
          )
        })}
      </ul>
      <a class="more" href={getLocalizedPath('/archive/', currentLang)}>全部文章 <span aria-hidden="true">→</span></a>
    </section>
  )}

  {homeProjects.length > 0 && (
    <section class="blk" aria-labelledby="projects-title">
      <div class="rule"><span class="n">III</span><h2 id="projects-title">造物</h2></div>
      <div class="feat">
        {homeProjects.map(project => (
          <a class="card card--plain" href={project.url} target="_blank" rel="noopener">
            <div>
              <h3>{project.name} <span class="arr" aria-hidden="true">→</span></h3>
              {project.desc && <p>{project.desc}</p>}
              {(project.stars > 0 || project.tags.length > 0) && (
                <div class="m">
                  {project.stars > 0 && <span>★ {project.stars}</span>}
                  {project.tags.map(tag => <span>{tag}</span>)}
                </div>
              )}
            </div>
          </a>
        ))}
        {homeProjects.length < 2 && (
          <div class="card card--plain card--empty">
            <div>
              <h3>下一个造物，正在酝酿</h3>
              <p>空着比编的好</p>
            </div>
          </div>
        )}
      </div>
      <a class="more" href={getLocalizedPath('/projects/', currentLang)}>全部项目 <span aria-hidden="true">→</span></a>
    </section>
  )}

  {homeFriends.length > 0 && (
    <section class="blk" aria-labelledby="friends-title">
      <div class="rule"><span class="n">IV</span><h2 id="friends-title">友邻</h2></div>
      <ul class="list list--friends">
        {homeFriends.map(friend => (
          <li>
            <a href={friend.url} target="_blank" rel="noopener">
              {friend.avatar
                ? <img src={friend.avatar} alt="" width="46" height="46" loading="lazy" data-fallback="/icons/favicon.svg" />
                : <span class="f-ava" aria-hidden="true" />}
              <div>
                <h3>{friend.name}</h3>
                {friend.desc && <span class="d">{friend.desc}</span>}
              </div>
              <span class="arr" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="more" href={getLocalizedPath('/friends/', currentLang)}>全部友邻 <span aria-hidden="true">→</span></a>
    </section>
  )}
</Layout>
<script>
  // 友链头像加载失败时回退到站点图标
  document.querySelectorAll<HTMLImageElement>('.list--friends img[data-fallback]').forEach((image) => {
    image.addEventListener('error', () => {
      image.src = image.dataset.fallback ?? '/icons/favicon.svg'
    }, { once: true })
  })
</script>

<style>
  a {
    color: inherit;
    text-decoration: none;
  }

  /* 首屏：左文右盘 */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 640px;
    gap: 56px;
    align-items: center;
    padding: 56px 0 40px;
  }
  .hero h1 {
    font-size: 50px;
    line-height: 1.32;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin: 18px 0 22px;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--accent);
    background: linear-gradient(transparent 82%, var(--hairline) 82%);
  }
  .hero .intro {
    color: var(--ink-soft);
    max-width: 30em;
    margin: 0 0 30px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .ava {
    width: 58px;
    height: 58px;
    flex: none;
    box-sizing: border-box;
    border-radius: 50%;
    padding: 3px;
    border: 1px solid var(--line);
    box-shadow: 0 0 0 4px var(--paper), 0 0 0 5px var(--hairline);
  }
  .ava img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
  .who .meta {
    font-size: 14px;
    color: var(--ink-faint);
    line-height: 1.6;
  }
  .who .meta b {
    display: block;
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
  }
  /* 印章推到行尾 */
  .who :global(.seal) {
    margin-left: auto;
  }

  /* 星盘容器；盘面样式由 Astrolabe 组件自带 */
  .dial {
    position: relative;
    width: 640px;
    aspect-ratio: 1;
    margin: 0;
  }

  /* 区块 */
  section.blk {
    margin-top: 76px;
  }

  /* 精选 / 造物：两列卡片 */
  .feat {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--hairline);
  }
  .card {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    padding: 26px 26px 28px 4px;
    border-bottom: 1px solid var(--hairline);
  }
  .card:nth-child(odd) {
    border-right: 1px solid var(--hairline);
    padding-right: 34px;
  }
  .card:nth-child(even) {
    padding-left: 34px;
  }
  .card :global(.chant-icon) {
    margin-top: 4px;
    transition: transform 0.8s ease;
  }
  .card:hover :global(.chant-icon) {
    transform: rotate(30deg);
  }
  /* .chant、.list 基础规则在 global.css */
  .card h3 {
    font-size: 20px;
    line-height: 1.5;
    margin: 4px 0 8px;
    font-weight: 600;
    transition: color 0.3s ease-out;
  }
  .card:hover h3 {
    color: var(--accent);
  }
  .card p {
    margin: 0 0 10px;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.8;
  }
  .card .m {
    font-size: 13px;
    color: var(--ink-faint);
  }
  .card .m > * + *::before {
    content: "·";
    margin: 0 7px;
    color: var(--line);
  }

  /* 造物卡片：无图标，单列 */
  .card--plain {
    grid-template-columns: 1fr;
  }
  .card--plain .arr {
    color: var(--accent);
  }
  .card--empty h3,
  .card--empty:hover h3 {
    color: var(--ink-soft);
  }
  .card--empty p {
    color: var(--ink-faint);
  }

  /* 最近 / 友邻：行列表基础规则见 global.css */

  /* 友邻行：圆形头像 + 名字描述 + 箭头 */
  .list--friends li a {
    grid-template-columns: 46px 1fr auto;
  }
  .list--friends img,
  .list--friends .f-ava {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    object-fit: cover;
    display: block;
    box-sizing: border-box;
  }
  .list--friends .d {
    display: block;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .list--friends .arr {
    color: var(--accent);
    transition: transform 0.3s ease-out;
  }
  .list--friends li a:hover .arr {
    transform: translateX(4px);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 15px;
    color: var(--accent);
  }

  @media (max-width: 1180px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .dial {
      width: min(640px, 100%);
      margin: 0 auto;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 30px;
      gap: 30px;
    }
    .hero h1 {
      font-size: 32px;
    }
    .feat {
      grid-template-columns: 1fr;
    }
    .card,
    .card:nth-child(n) {
      border-right: 0;
      padding: 22px 0;
    }
    .list--friends li a {
      grid-template-columns: 46px 1fr auto;
    }
  }
</style>
