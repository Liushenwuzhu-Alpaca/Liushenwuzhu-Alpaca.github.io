---
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/config'
import { getCollection, render } from 'astro:content'
import ChantIcon from '@/components/ChantIcon.astro'
import Comment from '@/components/Comment/Index.astro'
import PostDate from '@/components/PostDate.astro'
import PostNav from '@/components/PostNav.astro'
import ReadingProgress from '@/components/ReadingProgress.astro'
import RelatedPosts from '@/components/RelatedPosts.astro'
import SeriesBox from '@/components/SeriesBox.astro'
import TOC from '@/components/Widgets/TOC.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getTagPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { checkPostSlugDuplication, getAdjacentPosts, getRelatedPosts } from '@/utils/content'
import { getPostDescription } from '@/utils/description'
import { getGrowthStage, getRevisionCount } from '@/utils/postmeta'


export async function getStaticPaths() {
  const posts: CollectionEntry<'posts'>[] = await getCollection('posts')

  // Check if there are duplicate post slugs
  const duplicates = await checkPostSlugDuplication(posts)
  if (duplicates.length > 0) {
    throw new Error(`Duplicate post slugs:\n${duplicates.join('\n')}`)
  }

  // >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  // Build a map of post slugs to their supported languages
  // Handles both specific language posts (e.g., 'en') and universal posts (lang: '')
  const slugToLangsMap = new Map<string, Set<Language>>()

  for (const post of posts) {
    const slug = post.data.abbrlink || post.id.replace(/\.(md|mdx)$/, '')
    const lang = post.data.lang

    let langSet = slugToLangsMap.get(slug)
    if (!langSet) {
      langSet = new Set()
      slugToLangsMap.set(slug, langSet)
    }

    if (lang) {
      langSet.add(lang as Language)
    }
    else {
      allLocales.forEach(locale => langSet.add(locale))
    }
  }

  // Convert the map to a sorted record for the component props
  // Ensure languages are always sorted by the order defined in config
  const slugToLangs: Record<string, Language[]> = {}
  for (const [slug, langs] of slugToLangsMap) {
    slugToLangs[slug] = [...langs].sort((a, b) => allLocales.indexOf(a) - allLocales.indexOf(b))
  }
  // >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

  return allLocales.flatMap(lang => posts
    // Show drafts in dev mode only
    .filter(post => import.meta.env.DEV || !post.data.draft)
    // Match current language or universal posts
    .filter(post => post.data.lang === lang || post.data.lang === '')
    .map((post) => {
      const slug = post.data.abbrlink || post.id.replace(/\.(md|mdx)$/, '')
      return {
        params: { lang: getLangRouteParam(lang), slug },
        props: { post, supportedLangs: slugToLangs[slug] },
      }
    }),
  )
}

interface Props {
  post: CollectionEntry<'posts'>
  supportedLangs: Language[]
}

const { post, supportedLangs } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const slug = post.data.abbrlink || post.id.replace(/\.(md|mdx)$/, '')
const description = getPostDescription(post, 'meta')
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const { prev, next } = await getAdjacentPosts(slug, currentLang)
const relatedPosts = await getRelatedPosts(slug, currentLang)
// Resolve the content file path for git-based revision counting.
// The content loader uses `src/content/posts/` as base — reconstruct the path.
const contentPath = `src/content/posts/${post.id}`
const stage = getGrowthStage(post.data)
const revisionCount = getRevisionCount(contentPath)
const revisionHistoryUrl = `https://github.com/Liushenwuzhu-Alpaca/Liushenwuzhu-Alpaca.github.io/commits/main/${contentPath}`
const { tags } = post.data
---
<Layout
  postTitle={post.data.title}
  postDescription={description}
  postSlug={post.data.abbrlink || post.id.replace(/\.(md|mdx)$/, '')}
  supportedLangs={supportedLangs}
>
  <ReadingProgress />
  <article class="post">
    <header class="ph">
      <div class="ph-icon">
        <ChantIcon name={post.data.hymmnos ?? slug} size={150} transitionName={`icon-${slug}${currentLang ? `-${currentLang}` : ''}`} draw />
      </div>
      <div>
        {post.data.hymmnos && <span class="ph-chant" aria-hidden="true">{post.data.hymmnos}</span>}
        <h1 class="post-title">
          <span
            transition:name={`post-${slug}${currentLang ? `-${currentLang}` : ''}`}
            data-disable-theme-toggle-transition
          >
            {post.data.title}
          </span>
        </h1>
        <dl
          id="post-date"
          class="meta"
          transition:name={`time-${slug}${currentLang ? `-${currentLang}` : ''}`}
          data-disable-theme-toggle-transition
        >
          <div>
            <dt>DATE</dt>
            <dd><PostDate date={post.data.published} updatedDate={post.data.updated} /></dd>
          </div>
          <div>
            <dt>LENGTH</dt>
            <dd>{remarkPluginFrontmatter.minutes} 分钟</dd>
          </div>
          {tags.length > 0 && (
            <div>
              <dt>TAGS</dt>
              <dd>
                {tags.map((tag, i) => (
                  <>{i > 0 && ' / '}<a href={getTagPath(tag, currentLang)}>{tag}</a></>
                ))}
              </dd>
            </div>
          )}
          {post.data.series && (
            <div>
              <dt>SERIES</dt>
              <dd>{post.data.series}</dd>
            </div>
          )}
          <div>
            <dt>STATE</dt>
            <dd class:list={[stage.stage === 'seed' && 'is-seed']}>{stage.label}</dd>
          </div>
          {revisionCount !== null && revisionCount > 1 && (
            <div>
              <dt>REV</dt>
              <dd><a href={revisionHistoryUrl} target="_blank" rel="noopener noreferrer">{revisionCount} 次</a></dd>
            </div>
          )}
        </dl>
      </div>
    </header>

    <div class="layout">
      {post.data.toc && <aside class="post-toc"><TOC headings={headings} /></aside>}

      <div class="post-main heti">
        <div id="post-content">
          <Content />
        </div>
        <div id="post-copyright" />
        {post.data.series && (
          <SeriesBox series={post.data.series} currentId={slug} lang={currentLang} />
        )}
        {relatedPosts.length > 0 && (
          <hr class="hairline mt-12.6" />
          <RelatedPosts posts={relatedPosts} lang={currentLang} />
        )}
        {(prev || next) && (
          <hr class="hairline mt-12.6" />
          <PostNav {prev} {next} lang={currentLang} />
        )}
        <Comment />
      </div>
    </div>
  </article>

  <style>
    /* .ph / .ph-icon 网格与移动端规则在 global.css */

    /* 咏唱名（副标题）用塔语字形，纯装饰 */
    .ph-chant {
      font-family: "Hymmnos", var(--serif);
      font-size: 17px;
      letter-spacing: 0.06em;
      color: var(--glyph);
    }

    .post-title {
      max-width: 20em;
      margin: 8px 0 16px;
      font-size: 40px;
      font-weight: 600;
      line-height: 1.38;
      letter-spacing: 0.01em;
    }

    /* 元信息格子：等宽大写 dt + 正文 dd，竖线分隔 */
    .meta {
      display: flex;
      flex-wrap: wrap;
      margin: 22px 0 0;
      border-top: 1px solid var(--hairline);
    }

    .meta div {
      padding: 12px 26px 0 0;
      margin-right: 26px;
      border-right: 1px solid var(--hairline);
    }

    .meta div:last-child {
      margin-right: 0;
      border-right: 0;
    }

    .meta dt {
      font-family: var(--mono);
      font-size: 10.5px;
      letter-spacing: 0.14em;
      color: var(--ink-faint);
    }

    .meta dd {
      margin: 3px 0 0;
      font-size: 15px;
    }

    .meta dd.is-seed {
      color: var(--seal);
    }

    .meta a {
      color: inherit;
      text-decoration: none;
      transition: color 0.2s ease-out;
    }

    .meta a:hover {
      color: var(--accent);
    }

    /* 正文 + 右侧目录 */
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 720px) 240px;
      gap: 90px;
      justify-content: center;
      padding-top: 50px;
    }

    /* 没有目录（toc 关闭或标题不足）时正文单栏居中 */
    .layout:not(:has(#toc-container)) {
      grid-template-columns: minmax(0, 720px);
    }

    .layout:not(:has(#toc-container)) .post-toc {
      display: none;
    }

    .post-main {
      grid-row: 1;
      grid-column: 1;
      min-width: 0;
      max-width: none;
      font-size: 17px;
      line-height: 1.85;
    }

    .post-toc {
      position: sticky;
      top: 96px;
      grid-row: 1;
      grid-column: 2;
      align-self: start;
      font-size: 14px;
    }

    /* 窄屏：单栏，目录以折叠形式放到正文上方 */
    @media (max-width: 1100px) {
      .layout {
        grid-template-columns: minmax(0, 720px);
        gap: 0;
      }

      .post-main,
      .post-toc {
        grid-row: auto;
        grid-column: 1;
      }

      .post-toc {
        position: static;
      }
    }

    @media (max-width: 760px) {
      .post-title {
        font-size: 27px;
      }

      /* 窄屏格子会换行，竖线分隔改为纯留白 */
      .meta div {
        margin-right: 0;
        border-right: 0;
      }
    }
  </style>
</Layout>
