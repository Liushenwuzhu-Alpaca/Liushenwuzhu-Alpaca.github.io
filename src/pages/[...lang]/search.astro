---
import PageHead from '@/components/PageHead.astro'
import { allLocales } from '@/config'
import { getLangRouteParam } from '@/i18n/lang'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}
---

<Layout>
  <section aria-labelledby="search-title">
    <PageHead id="search-title" kicker="Search" title="搜索" hm="Was i ra knawa anw omnis." zh="迫不及待地，想要知晓一切" icon="SEARCH" />
    <div class="page-body heti">
      <div id="search" data-pagefind-ignore></div>
    </div>
  </section>
</Layout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const PagefindUI = Reflect.get(window, 'PagefindUI')
    if (PagefindUI) {
      Reflect.construct(PagefindUI, [{ element: '#search', showSubResults: true, resetStyles: false }])
    }
  })
</script>
